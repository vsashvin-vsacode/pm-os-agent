# Copy to .env and fill in. .env is gitignored, never commit your key.

# Your Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-...

# Model + bounds. These ARE your M5 deliverable, tune and justify them.
CORTEX_MODEL=claude-sonnet-5-5  # Claude Sonnet 5.5; a full run is ~cents
CORTEX_MAX_ITERATIONS=6       # loop cap: stop + escalate instead of spinning
CORTEX_MAX_REVISIONS=2        # critic<->drafter cap: stop the bounce-forever bomb
CORTEX_COST_CAP_USD=0.50      # hard spend cap per run, enforced outside the model
CORTEX_MAX_QUEUE_ITEMS=8      # commitment cap: max backlog stories queued per run
CORTEX_TIMEOUT_S=120          # wall-clock cap per run; also the model-call HTTP timeout
# Kill switch: create an empty file 00-build/STOP to halt Cortex; delete it to re-arm.

# Rough $ per 1M tokens for your chosen model (for the in-code cost estimate).
CORTEX_PRICE_IN_PER_M=2.00
CORTEX_PRICE_OUT_PER_M=10.00
